# ==========================================
# Microsoft Entra ID (MSAL)
# ==========================================
# Client ID de la App Registration en Microsoft Entra ID
VITE_CLIENT_ID=REEMPLAZAR_CON_APPLICATION_CLIENT_ID

# Tenant ID de la organización o directorio en Microsoft Entra ID
VITE_TENANT_ID=REEMPLAZAR_CON_DIRECTORY_TENANT_ID

# URI de redirección configurada en Azure (SPA redirect URI)
# En local: http://localhost:5173
# En EC2: http://<IP_PUBLICA_EC2>:5173 o tu dominio
VITE_REDIRECT_URI=http://localhost:5173

# ==========================================
# URLs de la Aplicación Arcadia
# ==========================================
# URL del API Gateway
VITE_API_GATEWAY_URL=http://localhost:8083

# URL del Frontend de Login
VITE_LOGIN_URL=http://localhost:5173

# URL del Frontend de Administración
VITE_ADMIN_URL=http://localhost:5174

# URL del Frontend de Clientes (Tienda de Comics)
VITE_CLIENTES_URL=http://localhost:3001
